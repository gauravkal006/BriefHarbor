# API server only. Use apps/api/.env.example as the copy template.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=briefharbor_dev
SESSION_SECRET=
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
# Explicit dev seed opt-in. Use a local password and keep it out of Git.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=

# Web app only. Use apps/web/.env.example as the copy template.
API_ORIGIN=http://127.0.0.1:4000
