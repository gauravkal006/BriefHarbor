{
  "name": "@briefharbor/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx --conditions=development src/server.ts",
    "seed": "node --env-file=.env --import tsx --conditions=development src/db/seed.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.vercel.json"
  },
  "dependencies": {
    "@briefharbor/contracts": "*",
    "argon2": "^0.44.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "mongodb": "^6.22.0"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/express-session": "^1.18",
    "@types/node": "^22",
    "tsx": "^4.21.0"
  }
}
